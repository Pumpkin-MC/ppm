# Maintainer: @MAINTAINER@
#
# This file is generated by the ppm repository's AUR workflow; edit
# .github/aur/PKGBUILD.in upstream instead of this file.

pkgname=@PKGNAME@
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Pumpkin Package Manager - CLI and package manager for Pumpkin Minecraft server plugins (prebuilt nightly)"
arch=('x86_64' 'aarch64')
url="https://github.com/@REPO@"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
provides=('ppm')
conflicts=('ppm')
options=('!strip' '!debug')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/@REPO@/@COMMIT@/LICENSE")
source_x86_64=("ppm-${pkgver}-x86_64::https://github.com/@REPO@/releases/download/@TAG@/ppm-X64-Linux")
source_aarch64=("ppm-${pkgver}-aarch64::https://github.com/@REPO@/releases/download/@TAG@/ppm-ARM64-Linux")
sha256sums=('@SHA_LICENSE@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  install -Dm755 "ppm-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/ppm"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  local ppm="${pkgdir}/usr/bin/ppm"
  export PPM_NO_SELF_INSTALL=1
  "${ppm}" completions bash | install -Dm644 /dev/stdin "${pkgdir}/usr/share/bash-completion/completions/ppm"
  "${ppm}" completions zsh | install -Dm644 /dev/stdin "${pkgdir}/usr/share/zsh/site-functions/_ppm"
  "${ppm}" completions fish | install -Dm644 /dev/stdin "${pkgdir}/usr/share/fish/vendor_completions.d/ppm.fish"
}
